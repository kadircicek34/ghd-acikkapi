# GHD Açık Kapı — local build of the customised Mobilizon source.
# The upstream project is AGPL-3.0; see LICENSE.

FROM node:22-alpine AS assets
RUN apk add --no-cache python3 build-base libwebp-tools bash imagemagick ncurses
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM elixir:1.16-alpine AS deps
RUN apk add --no-cache build-base git cmake
WORKDIR /app
ENV MIX_ENV=prod
COPY mix.exs mix.lock ./
COPY config/config.exs config/prod.exs ./config/
RUN mix local.hex --force \
    && mix local.rebar --force \
    && mix deps.get \
    && mix deps.compile

FROM deps AS builder
COPY config/docker.exs ./config/runtime.exs
COPY lib ./lib
COPY priv ./priv
COPY rel ./rel
COPY support ./support
COPY --from=assets /build/priv/static ./priv/static
RUN mix phx.digest.clean --all && mix phx.digest && mix release

FROM alpine:3.20
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="GHD Açık Kapı" \
      org.opencontainers.image.description="GHD Açık Kapı — customised Mobilizon instance" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.source="https://github.com/kadircicek34/ghd-acikkapi" \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.created=$BUILD_DATE

RUN apk add --no-cache curl openssl ca-certificates ncurses-libs file postgresql-client \
      libgcc libstdc++ imagemagick jpegoptim pngquant optipng libwebp-tools tzdata

RUN mkdir -p /var/lib/mobilizon/uploads/exports/{csv,pdf,ods} \
    && mkdir -p /var/lib/mobilizon/timezones /var/lib/mobilizon/tzdata /var/lib/mobilizon/sitemap /etc/mobilizon \
    && chown -R nobody:nobody /var/lib/mobilizon /etc/mobilizon

USER nobody
ENV MOBILIZON_DOCKER=true
EXPOSE 4000

COPY --from=builder --chown=nobody:nobody _build/prod/rel/mobilizon ./
RUN cp /releases/*/runtime.exs /etc/mobilizon/config.exs
COPY --chown=nobody:nobody docker/production/docker-entrypoint.sh ./docker-entrypoint.sh
ENTRYPOINT ["./docker-entrypoint.sh"]
